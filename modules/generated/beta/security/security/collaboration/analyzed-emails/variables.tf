variable "alert_ids" {
  description = "A collection of values that contain the IDs of any alerts associated with the email."
  type        = list(string)
  default     = null
}

variable "attachments" {
  description = "A collection of the attachments in the email."
  type = list(object({
    odata_type                     = optional(string, "#microsoft.graph.security.analyzedEmailAttachment")
    detonationDetails              = optional(any)
    fileExtension                  = optional(string)
    fileName                       = optional(string)
    fileSize                       = optional(number)
    fileType                       = optional(string)
    malwareFamily                  = optional(string)
    sha256                         = optional(string)
    tenantAllowBlockListDetailInfo = optional(string)
    threatType                     = optional(any)
  }))
  default = null
}

variable "authentication_details" {
  description = "The authentication details associated with the email."
  type        = any
  default     = null
}

variable "bulk_complaint_level" {
  description = "The bulk complaint level of the email. A higher level is more likely to be spam."
  type        = string
  default     = null
}

variable "client_type" {
  description = "Shows the type of client that sent the message (for example, REST)."
  type        = string
  default     = null
}

variable "contexts" {
  description = "Provides context of the email."
  type        = list(string)
  default     = null
}

variable "detection_methods" {
  description = "The methods of detection used."
  type        = list(string)
  default     = null
}

variable "directionality" {
  description = "The direction of the emails. The possible values are: unknown, inbound, outbound, intraOrg, unknownFutureValue."
  type        = any
  default     = null

  validation {
    condition     = var.directionality == null ? true : contains(["unknown", "inbound", "outbound", "intraOrg", "unknownFutureValue"], var.directionality)
    error_message = "directionality must be one of the documented enum values."
  }
}

variable "distribution_list" {
  description = "The distribution list details to which the email was sent."
  type        = string
  default     = null
}

variable "dlp_rules" {
  description = "Data loss prevention rules configured in purview."
  type = list(object({
    odata_type = optional(string, "#microsoft.graph.security.analyzedEmailDlpRuleInfo")
    name       = optional(string)
    ruleId     = optional(string)
  }))
  default = null
}

variable "email_cluster_id" {
  description = "The identifier for the group of similar emails clustered based on heuristic analysis of their content."
  type        = string
  default     = null
}

variable "exchange_transport_rules" {
  description = "The name of the Exchange transport rules (ETRs) associated with the email."
  type = list(object({
    odata_type = optional(string, "#microsoft.graph.security.analyzedEmailExchangeTransportRuleInfo")
    name       = optional(string)
    ruleId     = optional(string)
  }))
  default = null
}

variable "forwarding_detail" {
  description = "Email smtp forwarding details."
  type        = string
  default     = null
}

variable "inbound_connector_formatted_name" {
  description = "Custom instructions name that defines organizational mail flow and how the email was routed."
  type        = string
  default     = null
}

variable "internet_message_id" {
  description = "A public-facing identifier for the email that is sent. The message ID is in the format specified by RFC2822."
  type        = string
  default     = null
}

variable "language" {
  description = "The detected language of the email content."
  type        = string
  default     = null
}

variable "latest_delivery" {
  description = "The latest delivery details of the email."
  type        = any
  default     = null
}

variable "logged_date_time" {
  description = "Date-time when the email record was logged."
  type        = string
  default     = null
}

variable "network_message_id" {
  description = "An internal identifier for the email generated by Microsoft 365."
  type        = string
  default     = null
}

variable "odata_type" {
  description = "Microsoft Graph @odata.type property."
  type        = string
  default     = "#microsoft.graph.security.analyzedEmail"
  nullable    = false
}

variable "original_delivery" {
  description = "The original delivery details of the email."
  type        = any
  default     = null
}

variable "override_sources" {
  description = "An aggregated list of all overrides with source on email."
  type        = list(string)
  default     = null
}

variable "phish_confidence_level" {
  description = "The phish confidence level associated with the email"
  type        = string
  default     = null
}

variable "policy" {
  description = "The action policy that took effect."
  type        = string
  default     = null
}

variable "policy_action" {
  description = "The action taken on the email based on the configured policy."
  type        = string
  default     = null
}

variable "policy_type" {
  description = "Type of policy configured that defines the delivery action on email."
  type        = string
  default     = null
}

variable "primary_override_source" {
  description = "Shows the organization or user setting that altered the intended delivery location of the message (allowed instead of blocked, or blocked instead of allowed)."
  type        = string
  default     = null
}

variable "recipient_detail" {
  description = "Details of the recipients."
  type        = any
  default     = null
}

variable "recipient_email_address" {
  description = "Contains the email address of the recipient."
  type        = string
  default     = null
}

variable "return_path" {
  description = "A field that indicates where and how bounced emails are processed."
  type        = string
  default     = null
}

variable "sender_detail" {
  description = "Sender details of the email."
  type        = any
  default     = null
}

variable "size_in_bytes" {
  description = "Size of the email in bytes."
  type        = number
  default     = null
}

variable "spam_confidence_level" {
  description = "Spam confidence of the email."
  type        = string
  default     = null
}

variable "subject" {
  description = "Subject of the email."
  type        = string
  default     = null
}

variable "threat_detection_details" {
  description = "Information about threats detected in the email."
  type = list(object({
    odata_type                = optional(string, "#microsoft.graph.security.threatDetectionDetail")
    confidenceLevel           = optional(string)
    priorityAccountProtection = optional(string)
    threats                   = optional(string)
  }))
  default = null
}

variable "threat_types" {
  description = "Indicates the threat types. The possible values are: unknown, spam, malware, phish, none, unknownFutureValue."
  type        = any
  default     = null
}

variable "timeline_events" {
  description = "Delivery and post-delivery events that happened to the email."
  type = list(object({
    odata_type    = optional(string, "#microsoft.graph.security.timelineEvent")
    eventDateTime = optional(string)
    eventDetails  = optional(string)
    eventResult   = optional(string)
    eventSource   = optional(any)
    eventThreats  = optional(list(string))
    eventType     = optional(any)
  }))
  default = null
}

variable "urls" {
  description = "A collection of the URLs in the email."
  type = list(object({
    odata_type                     = optional(string, "#microsoft.graph.security.analyzedEmailUrl")
    detectionMethod                = optional(string)
    detonationDetails              = optional(any)
    tenantAllowBlockListDetailInfo = optional(string)
    threatType                     = optional(any)
    url                            = optional(string)
  }))
  default = null
}

variable "additional_properties" {
  description = "Additional writable Graph properties using API field names. Explicit typed inputs take precedence. Null top-level values are omitted; callers must omit nested nulls in untyped values."
  type        = any
  default     = {}
  nullable    = false
  sensitive   = true

  validation {
    condition     = can(keys(var.additional_properties)) ? alltrue([for key in keys(var.additional_properties) : !contains(["id"], key)]) : false
    error_message = "additional_properties must be an object without documented read-only properties."
  }
}
